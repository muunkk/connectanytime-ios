+static int check_reconnect_value(struct openconnect_info *vpninfo, const char *what,
+				 const char *now, const char *was)
+{
+	if (!was)
+		return 0;
+	if (!now) {
+		vpn_progress(vpninfo, PRG_ERR, _("Reconnect gave no %s (was %s)\n"), what, was);
+		return -EPERM;
 	}
+	if (strcmp(now, was))
+		vpn_progress(vpninfo, PRG_INFO, _("Reconnect gave a new %s (%s, was %s)\n"), what, now, was);
+	return 0;
 }
 
