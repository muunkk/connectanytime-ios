+/* The session cookie with the STRAP key OpenConnect holds now, or NULL. Every CONNECT on
+ * a live session rekeys: it signs with the old key and hands the server a new one. The
+ * cookie still carries the key from login, so a client that saves it can't resume the
+ * session in a new process. The caller frees (and should wipe) the result. */
+static char *strap_cookie(struct openconnect_info *vpninfo)
+{
+#ifdef HAVE_HPKE_SUPPORT
+	static const char prefix[] = "openconnect_strapkey=";
+	struct oc_text_buf *buf;
+	const char *rest;
+	char *cookie = NULL;
+
+	if (vpninfo->no_external_auth || !vpninfo->strap_key || !vpninfo->cookie ||
+	    strncmp(vpninfo->cookie, prefix, sizeof(prefix) - 1) ||
+	    !(rest = strchr(vpninfo->cookie, ';')))
+		return NULL;
+
+	buf = buf_alloc();
+	if (!buf)
+		return NULL;
+	/* Room for all of it at once: a buffer that grows leaves the key in the memory it
+	 * moved out of. (The cookie already holds a key of this size, or none.) */
+	buf_ensure_space(buf, strlen(vpninfo->cookie) + 512);
+	buf_append(buf, "%s", prefix);
+	append_strap_privkey(vpninfo, buf);
+	buf_append(buf, "%s", rest);
+	if (!buf_error(buf) && buf->pos > (int)(sizeof(prefix) - 1 + strlen(rest))) {
+		cookie = buf->data;
+		buf->data = NULL;
+	} else if (buf->data) {
+		clear_mem(buf->data, buf->buf_len);
+	}
+	buf_free(buf);
+	return cookie;
+#else
+	(void)vpninfo;
+	return NULL;
+#endif
+}
+
+/* The server accepted the key this CONNECT presented: put it in the cookie. Fails
+ * (-ENOMEM) only if there is a key to put there and it couldn't be. */
+static int refresh_strap_cookie(struct openconnect_info *vpninfo)
+{
+	char *cookie = strap_cookie(vpninfo);
+
+	if (!cookie)
+		return (vpninfo->strap_key && vpninfo->cookie &&
+			!strncmp(vpninfo->cookie, "openconnect_strapkey=", 21)) ? -ENOMEM : 0;
+	clear_mem(vpninfo->cookie, strlen(vpninfo->cookie));
+	free(vpninfo->cookie);
+	vpninfo->cookie = cookie;
+	vpn_progress(vpninfo, PRG_DEBUG, _("Refreshed STRAP key in session cookie\n"));
+	return 0;
+}
+
+/* The cookie with the key OpenConnect would present next. It differs from
+ * openconnect_get_cookie() after a CONNECT that sent a new key but got no 200: the
+ * server holds one of the two. Until a 200, every CONNECT presents this same key. */
+char *openconnect_strap_candidate_cookie(struct openconnect_info *vpninfo)
+{
+	return strap_cookie(vpninfo);
+}
+
+/* For a client that saves the session to resume it in another process, which may be
+ * killed at any moment. The handler runs on the thread that's running OpenConnect:
+ *  - just before a CONNECT that presents a new STRAP key is sent, when
+ *    openconnect_strap_candidate_cookie() first gives that key. The request waits for
+ *    the handler, so a client that saves both cookies in it has the new key on disk
+ *    before the server can hold it;
+ *  - when a CONNECT gets its 200, with the accepted key now in the cookie. */
+void openconnect_set_session_changed_handler(struct openconnect_info *vpninfo,
+					     openconnect_session_changed_vfn handler)
+{
+	vpninfo->session_changed = handler;
+}
+
+/* The CONNECT that presented the unresolved key never left, or the server answered it
+ * with an error. Then the server most likely still holds the accepted key, so the next
+ * CONNECT is that same request again: the same new key, signed with the accepted one.
+ * (Not after a 401, which ends the session here; and whether a server that answers 503
+ * has already taken the key is a guess. It's a safe one: either way the key presented
+ * is the candidate, so the saved pair still holds whichever key the server has.) */
+static void strap_not_taken(struct openconnect_info *vpninfo)
+{
+#ifdef OPENCONNECT_OPENSSL /* whose append_strap_verify() can sign with the previous key */
+	if (vpninfo->strap_unresolved)
+		vpninfo->strap_unresolved = STRAP_NOT_TAKEN;
+#else
+	(void)vpninfo;
+#endif
+}
